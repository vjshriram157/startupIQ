{
  "expo": {
    "name": "StartupIQ",
    "slug": "StartupIQ",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "startupiq",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0B12",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.startupiq.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0B0B12",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "86215e3d-ee90-4373-be46-3d9032c146b1"
      }
    },
    "owner": "vjshriram157"
  }
}
